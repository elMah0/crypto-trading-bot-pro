# ==============================================================================
# VARIABLES DE ENTORNO (CLAVES SECRETAS Y CREDENCIALES)
# ==============================================================================
# Copia este archivo como '.env' y completa con tus credenciales reales.
# IMPORTANTE: Nunca subas tu archivo '.env' a repositorios públicos de Git.

# Credenciales del Exchange (CCXT)
EXCHANGE_API_KEY=tu_api_key_aqui
EXCHANGE_API_SECRET=tu_api_secret_aqui
EXCHANGE_PASSWORD=                  # Opcional (requerido para exchanges como KuCoin o OKX)

# Credenciales de Telegram Bot
# Puedes crear un bot hablando con @BotFather en Telegram para obtener el TOKEN.
# Puedes obtener tu CHAT_ID hablando con @userinfobot o creando un grupo y usando un bot de ID.
TELEGRAM_BOT_TOKEN=tu_telegram_bot_token_aqui
TELEGRAM_CHAT_ID=tu_telegram_chat_id_aqui
